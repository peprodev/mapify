#. Plugin Name of the plugin
#: pepro-mapify.php
msgid "PeproDev Branches Map (Mapify)"
msgstr "نقشه شعب پپرو (مپیفای)"

#. Plugin URI of the plugin
#: pepro-mapify.php
msgid "https://pepro.dev/mapify"
msgstr ""

#. Description of the plugin
#: pepro-mapify.php
msgid "Show your branches on Google Maps, OpenStreetMap, Mapbox, Map.ir, custom SVG/image maps or an offline map of Iran. Works as a shortcode, an Elementor widget and a WPBakery Page Builder element."
msgstr "شعبه‌های خود را روی گوگل‌مپ، اوپن‌استریت‌مپ، مپ‌باکس، مپ‌دات‌آی‌آر، نقشه‌های SVG و تصویری یا نقشه آفلاین ایران نمایش دهید. به‌صورت شورت‌کد، ابزارک المنتور و المان ویژوال‌کامپوزر (WPBakery) کار می‌کند."

#. Author of the plugin
#: pepro-mapify.php
msgid "Pepro Dev. Group"
msgstr "گروه توسعه پپرو"

